{
  "title": "IEEE 9-Bus Diesel Generator",
  "type": "object",
  "properties": {
    "imageTag": {
      "description": "Override image tag. Defaults to the chart appVersion.",
      "type": "string",
      "default": ""
    },
    "replicas": {
      "description": "Replica count for diesel-gen.",
      "type": "integer",
      "minimum": 0,
      "default": 1
    },
    "gridCentralUrl": {
      "description": "Base URL of the grid-central power-flow engine (in-namespace by default).",
      "type": "string",
      "default": "http://grid-central:8000"
    },
    "tickInterval": {
      "description": "Seconds between telemetry ticks.",
      "type": "string",
      "default": "1.0"
    },
    "ingressEnabled": {
      "description": "Expose diesel-gen via Ingress.",
      "type": "boolean",
      "default": false
    },
    "ingressHost": {
      "description": "Ingress host when enabled.",
      "type": "string",
      "default": "diesel.example.com"
    },
    "ingressClassName": {
      "description": "Optional IngressClass name.",
      "type": "string",
      "default": ""
    },
    "tlsEnabled": {
      "description": "Issue an LE certificate via cert-manager when ingress is enabled.",
      "type": "boolean",
      "default": true
    },
    "tlsClusterIssuer": {
      "description": "cert-manager ClusterIssuer used for the certificate.",
      "type": "string",
      "default": "letsencrypt-prod"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "ingressEnabled": { "const": true } },
        "required": ["ingressEnabled"]
      },
      "then": {
        "properties": { "ingressHost": { "minLength": 1 } },
        "required": ["ingressHost"]
      }
    }
  ]
}
