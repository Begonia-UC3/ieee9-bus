{
  "title": "IEEE 9-Bus Grid",
  "type": "object",
  "properties": {
    "imageTag": {
      "description": "Override image tag for all services. Defaults to the chart appVersion.",
      "type": "string",
      "default": ""
    },
    "replicas": {
      "description": "Replica count applied to every service.",
      "type": "integer",
      "minimum": 0,
      "default": 1
    },
    "ingressEnabled": {
      "description": "Expose grid-central via Ingress.",
      "type": "boolean",
      "default": false
    },
    "ingressHost": {
      "description": "Ingress host when enabled.",
      "type": "string",
      "default": "ieee9.example.com"
    },
    "ingressClassName": {
      "description": "Optional IngressClass name.",
      "type": "string",
      "default": ""
    },
    "tlsEnabled": {
      "description": "Issue an LE certificate via cert-manager when ingress is enabled.",
      "type": "boolean",
      "default": true
    },
    "tlsClusterIssuer": {
      "description": "cert-manager ClusterIssuer used for the certificate.",
      "type": "string",
      "default": "letsencrypt-prod"
    },
    "batteryIngressEnabled": {
      "description": "Expose battery UI via Ingress.",
      "type": "boolean",
      "default": false
    },
    "batteryIngressHost": {
      "description": "Ingress host for battery when enabled.",
      "type": "string",
      "default": "battery.example.com"
    },
    "datacenterIngressEnabled": {
      "description": "Expose datacenter UI via Ingress.",
      "type": "boolean",
      "default": false
    },
    "datacenterIngressHost": {
      "description": "Ingress host for datacenter when enabled.",
      "type": "string",
      "default": "datacenter.example.com"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "ingressEnabled": { "const": true } },
        "required": ["ingressEnabled"]
      },
      "then": {
        "properties": { "ingressHost": { "minLength": 1 } },
        "required": ["ingressHost"]
      }
    },
    {
      "if": {
        "properties": { "batteryIngressEnabled": { "const": true } },
        "required": ["batteryIngressEnabled"]
      },
      "then": {
        "properties": { "batteryIngressHost": { "minLength": 1 } },
        "required": ["batteryIngressHost"]
      }
    },
    {
      "if": {
        "properties": { "datacenterIngressEnabled": { "const": true } },
        "required": ["datacenterIngressEnabled"]
      },
      "then": {
        "properties": { "datacenterIngressHost": { "minLength": 1 } },
        "required": ["datacenterIngressHost"]
      }
    }
  ]
}
